<?xml version="1.0" encoding="utf-8"?>
<!-- SatarkPay skeleton · sirf 3 optional permissions, koi SMS/Contacts/Accessibility/QUERY_ALL_PACKAGES nahi -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <application android:label="SatarkPay" android:theme="@style/Theme.SatarkPay">
        <activity android:name=".MainActivity" android:exported="true"/>
        <activity android:name=".consent.ConsentActivity" android:exported="false"/>
        <service android:name=".signals.MandateNotifications" android:exported="false"
                 android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"/>
    </application>
</manifest>
