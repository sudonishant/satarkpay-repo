<?xml version="1.0" encoding="utf-8"?>
<!-- Security hardened backup rules for SatarkPay.
     All local databases, shared preferences, and files are excluded
     to prevent sensitive fraud reports and payee records from leaking. -->
<full-backup-content>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="root" path="."/>
</full-backup-content>
